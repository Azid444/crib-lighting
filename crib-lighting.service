# sudo cp crib-lighting.service /etc/systemd/system/
# sudo systemctl enable --now crib-lighting
[Unit]
Description=Crib Lighting
After=network-online.target bluetooth.target
Wants=network-online.target

[Service]
WorkingDirectory=/home/pi/crib-lighting
Environment=CRIB_CONFIG=/home/pi/crib-lighting/config.yaml
ExecStart=/home/pi/crib-lighting/.venv/bin/python -m crib.app
Restart=always
RestartSec=5
User=pi

[Install]
WantedBy=multi-user.target
